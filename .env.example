# nas-console 配置（部署到 NAS 容器时用环境变量注入，勿提交真实值）
# --- 初始管理员账号（首次启动 seed，之后以数据库为准） ---
NAS_CONSOLE_USERNAME=admin
NAS_CONSOLE_PASSWORD=change-me-strong-password
# --- 执行模式 ---
# 容器内（NAS）：设 1，走 nsenter 进宿主 shell
# 本地开发：留空，直接 spawn sh
NAS_CONSOLE_NSENTER=0
# --- 服务 ---
PORT=8890
# --- SQLite 路径 ---
NAS_CONSOLE_DB=./data/nas-console.db
# --- 会话时效（秒） ---
SESSION_TTL_SECONDS=86400