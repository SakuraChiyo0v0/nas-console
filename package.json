{
  "name": "nas-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "NAS web console: web terminal for humans + HTTP exec API for AI/programs (host shell via nsenter)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx server/src/**/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
